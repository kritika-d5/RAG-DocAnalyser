# ===== Backend environment =====
# Copy this file to `.env` (same folder) and fill in real values.
# The backend reads these via python-dotenv on startup.

# --- Groq (LLM generation) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- MongoDB (document + vector storage) ---
# Atlas free tier works: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=docanalyser
COLLECTION_NAME=documents

# --- Embeddings (optional override) ---
# Defaults to sentence-transformers/all-MiniLM-L6-v2 (local, via fastembed).
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=/tmp/fastembed_cache

# --- LLM model (optional override) ---
# Groq retires models periodically; if answers stop working, check
# https://console.groq.com/docs/models and change this.
# GROQ_MODEL=openai/gpt-oss-20b
